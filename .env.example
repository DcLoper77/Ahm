# Server-only Next.js rewrite target. The browser calls the same-origin /admin/v1 path so the
# dedicated host-only session cookie remains first-party at controlpanel.havenerr.info.
HAVENERR_ADMIN_UPSTREAM_ORIGIN=http://127.0.0.1:5000

# Invitation URLs use the current browser origin; no admin-origin value is exposed through a
# NEXT_PUBLIC_* variable.
